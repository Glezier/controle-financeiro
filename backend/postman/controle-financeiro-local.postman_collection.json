    {
      "name": "07 - Cadastro renovacao e saida",
      "item": [
        {
          "name": "Cadastro local opcional",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/api/v1/auth/register",
            "auth": {
              "type": "noauth"
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"postman-{{$guid}}@local.test\",\n  \"password\": \"Demo12345!\",\n  \"full_name\": \"Conta Postman\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 201', function () { pm.response.to.have.status(201); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Renovar sessao",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/api/v1/auth/refresh",
            "auth": {
              "type": "noauth"
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh_token\": \"{{refresh_token}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', function () { pm.response.to.have.status(200); });",
                  "if (pm.response.code === 200) {",
                  "const session = pm.response.json().data.session;",
                  "pm.collectionVariables.set('access_token', session.access_token);",
                  "pm.collectionVariables.set('refresh_token', session.refresh_token);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Logout - executar por ultimo",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/api/v1/auth/logout",
            "header": []
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 204', function () { pm.response.to.have.status(204); });",
                  "if (pm.response.code === 204) {",
                  "pm.collectionVariables.set('access_token', '');",
                  "pm.collectionVariables.set('refresh_token', '');",
                  "}"
                ]
              }
            }
          ]
        }
      ]
    }
