                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"demo@local.test\",\n  \"password\": \"Demo12345!\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', function () { pm.response.to.have.status(200); });",
                  "if (pm.response.code === 200) {",
                  "const session = pm.response.json().data.session;",
                  "pm.collectionVariables.set('access_token', session.access_token);",
                  "pm.collectionVariables.set('refresh_token', session.refresh_token);",
                  "}"
                ]
              }
            }
          ]
        },
