generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum TransactionType {
  income
  expense
}

enum TransactionStatus {
  paid
  pending
}

model Category {
  id        String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String          @map("user_id") @db.Uuid
  name      String          @db.Text
  type      TransactionType
  icon      String          @default("category") @db.Text
  createdAt DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)

  transactions Transaction[]

  @@unique([userId, type, name])
  @@unique([id, userId, type])
  @@map("categories")
}

model Transaction {
  id          String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String            @map("user_id") @db.Uuid
  categoryId  String            @map("category_id") @db.Uuid
  type        TransactionType
  amount      Decimal           @db.Decimal(12, 2)
  date        DateTime          @db.Date
  description String            @db.Text
  status      TransactionStatus
  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)

  category Category @relation(fields: [categoryId, userId, type], references: [id, userId, type], onDelete: Restrict, onUpdate: Restrict)

  @@index([userId, date])
  @@index([userId, type, status, date])
  @@index([categoryId, userId, type])
  @@map("transactions")
}
